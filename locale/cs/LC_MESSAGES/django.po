msgstr "Množství se mění hned. Účet k nákupu nepotřebujete."

#: apps/demoshop/sales_notes.py:83
msgid "Нова Пошта в оформленні"
msgstr "Nova Poshta v pokladně"

#: apps/demoshop/sales_notes.py:85
